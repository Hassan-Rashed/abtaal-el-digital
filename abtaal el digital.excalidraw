    {
      "id": "vUMqe74oJ8udXIuLzba1m",
      "type": "text",
      "x": 16924.83319438184,
      "y": 6893.542892317559,
      "width": 1834.16357421875,
      "height": 3150,
      "angle": 0,
      "strokeColor": "#2f9e44",
