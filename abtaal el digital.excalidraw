    {
      "id": "i5qtXXx6do1Csa8Junhf3",
      "type": "text",
      "x": 16774.882264305965,
      "y": 1482.6510021926929,
      "width": 2594.9308965773803,
      "height": 754.2857142857143,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 979322166,
      "version": 431,
      "versionNonce": 594314666,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789380696464,
      "created": 1789376531361,
      "link": null,
      "locked": false,
      "text": "\n\n\nUser profiles: Candidate make profile. He put his skill and education. Employer make company profile too.\n\nJob posts: Employer add new job. He write the skills he want. He put budget also.\n\nMatching: System find good jobs to candidate. System find good candidates to employer.\n\nApplications: Candidate apply for job. Employer change the status. Status can be apply, interview or reject. System not allow apply two time.\n\nSkill gap: System compare candidate skill and job. It tell candidate what missing skill he need.\n\nSearch: Candidate search job by keyword and money. Employer search candidate by experience.\n\nNotifications: System send notification. It send email if status change or new match.",
      "fontSize": 37.71428571428572,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\n\nUser profiles: Candidate make profile. He put his skill and education. Employer make company profile too.\n\nJob posts: Employer add new job. He write the skills he want. He put budget also.\n\nMatching: System find good jobs to candidate. System find good candidates to employer.\n\nApplications: Candidate apply for job. Employer change the status. Status can be apply, interview or reject. System not allow apply two time.\n\nSkill gap: System compare candidate skill and job. It tell candidate what missing skill he need.\n\nSearch: Candidate search job by keyword and money. Employer search candidate by experience.\n\nNotifications: System send notification. It send email if status change or new match.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
